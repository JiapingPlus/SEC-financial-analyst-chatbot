# Paste these values into Streamlit Community Cloud > Advanced settings > Secrets.
# Never rename this example to secrets.toml and commit real credentials.
OPENAI_API_KEY = "your-openai-api-key"
OPENAI_CHAT_MODEL = "gpt-4.1-mini"
OPENAI_EMBEDDING_MODEL = "text-embedding-3-small"
PUBLIC_DEMO = "true"
DEMO_SESSION_QUESTION_LIMIT = "8"
DEMO_PROCESS_QUESTION_LIMIT = "100"
